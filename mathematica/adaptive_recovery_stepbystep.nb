Cell[CellGroupData[{

Cell["Helper Functions", "Subsection",
 CellChangeTimes->{{3.98668019445693*^9, 
  3.986680197173893*^9}},ExpressionUUID->"fbbb5e83-1ca4-ac41-8ca1-\
cd6d9627082b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Helper", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Vectorize", "[", "rho_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Transpose", "[", "rho", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UnVectorize", "[", "rho_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rowVec", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rowVec", "=", 
        RowBox[{"Flatten", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Partition", "[", 
         RowBox[{"rowVec", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "[", "rowVec", "]"}], "]"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ApplyKraus", "[", 
     RowBox[{"kraus_", ",", "rho_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "Nkraus", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"k", ".", "rho", ".", 
         RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "kraus"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
      "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ApplyMap", "[", 
      RowBox[{"M_", ",", "rho_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"UnVectorize", "[", 
        RowBox[{"M", ".", 
         RowBox[{"Vectorize", "[", "rho", "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Checks", " ", "if"}], "||", 
     RowBox[{"m1", "-", "m2"}], "||", " ", 
     RowBox[{"<", "tolerance"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IsMatrixClose", "[", 
     RowBox[{"m1_", ",", "m2_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"m1", "-", "m2"}], "]"}], "<", "tol"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Compute", " ", "Quantum", " ", "Fidelity", " ", "F"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Tr", "|", 
        RowBox[{"sqrt", 
         RowBox[{
          RowBox[{"(", "rho", ")"}], ".", "sigma", ".", "sqrt"}], 
         RowBox[{"(", "rho", ")"}]}], "|"}], ")"}], "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Fidelity", "[", 
      RowBox[{"rho_", ",", "sigma_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "s", ",", "prod", ",", "traceVal"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"Chop", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"s", "=", 
         RowBox[{"Chop", "[", "sigma", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prod", "=", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"r", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}], ".", "s", ".", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"r", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"traceVal", "=", 
         RowBox[{"Tr", "[", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"prod", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Abs", "[", "traceVal", "]"}], "^", "2"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9800743882785797`*^9, 3.980074456543476*^9}, {
  3.980074530380436*^9, 3.9800746049117126`*^9}, {3.9800755046264668`*^9, 
  3.9800755050601635`*^9}, {3.980075571043398*^9, 3.980075631183815*^9}, {
  3.9866802021137505`*^9, 3.986680334830883*^9}, {3.9866803904449253`*^9, 
  3.986680431326538*^9}, {3.9866805098866043`*^9, 3.9866805194095154`*^9}, {
  3.98668063762241*^9, 3.9866806385470276`*^9}, {3.986680870665167*^9, 
  3.9866808878458157`*^9}},
 CellLabel->
