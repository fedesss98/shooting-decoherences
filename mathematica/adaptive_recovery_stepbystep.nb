Cell["\<\
Apply Noise to the state and Recover it.
We can recover using Kraus Operators of the Liouville Operator:\
\>", "Text",
 CellChangeTimes->{{3.9800756814179688`*^9, 3.980075689519499*^9}, {
  3.9802191127700825`*^9, 
  3.9802191425689754`*^9}},ExpressionUUID->"faf0e8a5-d350-db46-9638-\
a06c8d94a731"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
