Cell[CellGroupData[{

Cell["Note", "Subsection",
 CellChangeTimes->{{3.9866824668553734`*^9, 
  3.9866824678645344`*^9}},ExpressionUUID->"1f5a1b2b-f01b-604a-be77-\
15e4dcce7d03"],

Cell[TextData[{
 "The maps are becoming more and more a ",
 StyleBox["Pin Map",
  FontWeight->"Bold"],
 ", with the first and last columns equal to the vectorized state to recover \
\[Rho]0 and other columns null. Whatever is the input ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["X", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "$X$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebfa426f-0fa5-514c-a855-6f5a5b08b65c"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"[", 
           StyleBox["X", "TI"], "]"}], "\[LongEqual]", "vec", 
         RowBox[{"(", 
           SubscriptBox["\[Rho]", "0"], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "$P[X]=\\text{vec}(\\rho_0)$", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b337435-55b8-a847-ae72-7b4b2412b021"],
 ".\nWe can see this plotting the differences between the rows of the Petz \
maps implemented and the vectorized \[Rho]0."
}], "Text",
 CellChangeTimes->{{3.986682472354208*^9, 3.9866826147557564`*^9}, {
  3.9866826472425613`*^9, 
  3.9866826892025394`*^9}},ExpressionUUID->"656bd1aa-b27d-9e42-8dc2-\
a158fca2e31b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"maps", "=", 
   RowBox[{"{", 
    RowBox[{
    "P1", ",", "P2", ",", "P3", ",", "P4", ",", "P5", ",", "P6", ",", "P7", ",",
      "P8"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "data", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Vectorize", "[", "\[Rho]0", "]"}], "-", "#"}], "]"}], 
           "&"}], "/@", "map"}], ",", 
         RowBox[{"{", 
          RowBox[{"map", ",", 
           RowBox[{"Transpose", "/@", "maps"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", "data", "]"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<$vec(\\rho_0)-col1$\>\"", ",", "\"\<$vec(\\rho_0)-col2$\>\"",
       ",", "\"\<$vec(\\rho_0)-col3$\>\"", 
      ",", "\"\<$vec(\\rho_0)-col4$\>\""}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
