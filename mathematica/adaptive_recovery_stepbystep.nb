Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"RandomDM", "[", "d_Integer", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"psi", ",", "rho"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"psi", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", "]"}], ",", 
         RowBox[{"{", "d", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"psi", "=", 
       RowBox[{"psi", "/", 
        RowBox[{"Norm", "[", "psi", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"rho", "=", 
       RowBox[{"Outer", "[", 
        RowBox[{"Times", ",", "psi", ",", 
         RowBox[{"Conjugate", "[", "psi", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rhoFullRank", "=", 
       RowBox[{
        RowBox[{"0.75", "rho"}], "+", 
        RowBox[{"0.25", "*", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], "/", "2"}]}]}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]0", "=", 
   RowBox[{"RandomDM", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]0", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Eigenvalues: \>\"", ",", " ", 
   RowBox[{"Eigenvalues", "[", "\[Rho]0", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Trace: \>\"", ",", " ", 
   RowBox[{"\[Rho]0", "//", "Tr"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Purity: \>\"", ",", " ", 
   RowBox[{"Tr", "[", 
    RowBox[{"\[Rho]0", ".", "\[Rho]0"}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.979992696556881*^9, 3.9799927148378315`*^9}, {
