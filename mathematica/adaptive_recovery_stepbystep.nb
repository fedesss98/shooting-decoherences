Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "The", " ", "Channels", " ", "Properly", " ", 
    RowBox[{"(", 
     RowBox[{"No", " ", 
      RowBox[{"MatrixForm", "!"}]}], ")"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"kBitFlip", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", "p"}], "]"}], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sqrt", "[", "p", "]"}], " ", 
        RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kDephase", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", "p"}], "]"}], " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Sqrt", "[", "p", "]"}], " ", 
        RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Define", " ", "the", " ", "Petz", " ", "Function"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PetzKraus", "[", 
     RowBox[{"kList_", ",", "sigma_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"omega", ",", "invSqrtOmega", ",", "sqrtSigma"}], "}"}], ",", 
      RowBox[{
       RowBox[{"omega", "=", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"k", ".", "sigma", ".", 
            RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "kList"}], "}"}]}], "]"}], "//", 
         "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Use", " ", "PseudoInverse", " ", "for", " ", "safety"}], ",", 
         RowBox[{
          RowBox[{
          "though", " ", "Inverse", " ", "works", " ", "for", " ", "p"}], "<",
           "1"}]}], "*)"}], 
       RowBox[{"invSqrtOmega", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"DiagonalMatrixQ", "[", "omega", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"DiagonalMatrix", "[", 
           RowBox[{
            RowBox[{"Diagonal", "[", "omega", "]"}], "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "2"}], ")"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"omega", ",", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], " ", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Fallback", " ", "for", " ", "non"}], "-", "diagonal"}], 
          "*)"}], "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sqrtSigma", "=", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"sigma", ",", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"sqrtSigma", ".", 
          RowBox[{"ConjugateTranspose", "[", "k", "]"}], ".", 
          "invSqrtOmega"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "kList"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Compute", " ", "Superoperators"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Function", " ", "to", " ", "convert", " ", "Kraus"}], "->", 
     RowBox[{"Liouville", " ", "Superoperator"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ToSuperOp", "[", "kList_", "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"k", ",", 
        RowBox[{"Conjugate", "[", "k", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "kList"}], "}"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Compare"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigmaRef", "=", "\[Rho]0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"recBF", "=", 
     RowBox[{"PetzKraus", "[", 
      RowBox[{"kBitFlip", ",", "sigmaRef"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"recDeph", "=", 
     RowBox[{"PetzKraus", "[", 
      RowBox[{"kDephase", ",", "sigmaRef"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Are the recovery Superoperators equal?\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ToSuperOp", "[", "recBF", "]"}], "]"}], "==", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ToSuperOp", "[", "recDeph", "]"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nBit-Flip Recovery Liouville (p=0.1):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ToSuperOp", "[", "recBF", "]"}], "/.", " ", 
     RowBox[{"p", "->", "0.1"}]}], "//", "MatrixForm"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\nDephasing Recovery Liouville (p=0.1):\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ToSuperOp", "[", "recDeph", "]"}], "/.", " ", 
     RowBox[{"p", "->", "0.1"}]}], "//", "MatrixForm"}]}]}]], "Input",
