Cell[CellGroupData[{

Cell["5. Long term behaviour of the maps", "Section",
 CellChangeTimes->{{3.980553009684717*^9, 
  3.9805530242398777`*^9}},ExpressionUUID->"a3ec6a2e-1611-1443-a2fe-\
61ab0c14c930"],

Cell[TextData[{
 "We want to check that after some number of steps the Petz maps converges to \
one replacement channel.\nNo matter the map chosen to recover from, the final \
supermap will be the Identity.\nWe do this in two parts:\n \t1. Choose two \
possible noises ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b87585ee-e6f0-6f4d-9dac-27fc3e9ad5a7"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa0abd72-0e8c-324a-aef7-dc89fee70fbd"],
 ". Choose one \[OpenCurlyDoubleQuote]noise history\[CloseCurlyDoubleQuote] \
with fixed noise ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["x", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Omega_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8670889-df36-834a-815a-19311b2224d2"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["N", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["x", "TI"]], "\[EmptySmallCircle]", "\[Ellipsis]", 
         SuperscriptBox[
          StyleBox["P", "TI"], "1"], "\[EmptySmallCircle]", 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["x", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{N}^n=\\mathcal{P}^n\\circ\\Omega_x\\circ\\ldots\\mathcal{P}^1\
\\circ\\Omega_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "381df401-f18e-f241-970c-cf4cafe0c10e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19b94aa7-0d09-7f41-909c-1162519dd398"],
 " are random recoveries of the preceeding noise (supposing it is always ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea029fa9-b3ca-f948-8d56-640a5e8e0c74"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e94245f7-3a18-dd4c-91ec-b0bd0e68780d"],
 ").\n \t2. Choose two possible noises ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2007ce85-65f7-9e40-9730-682718dba573"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm], "errors" -> {},
      "input" -> "\\Omega_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ee0bb5b-1936-094e-8cae-bd902129f359"],
 ". Choose one \[OpenCurlyDoubleQuote]noise history\[CloseCurlyDoubleQuote] \
with fixed noise ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalOmega]", 
        StyleBox["x", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Omega_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "534fcdd8-5b6f-fe46-b9fd-dd13c449ecc2"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["N", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["n", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["x", "TI"]], "\[EmptySmallCircle]", "\[Ellipsis]", 
         SuperscriptBox[
          StyleBox["P", "TI"], "1"], "\[EmptySmallCircle]", 
         SubscriptBox["\[CapitalOmega]", 
          StyleBox["x", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{N}^n=\\mathcal{P}^n\\circ\\Omega_x\\circ\\ldots\\mathcal{P}^1\
\\circ\\Omega_x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb928851-20c4-0345-9b43-0f45e07d3a8f"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "P^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8dbe245a-1565-ee4c-8bd5-fd2776c3db00"],
 " is always the wrong recovery."
}], "Text",
 CellChangeTimes->{{3.9805530274306717`*^9, 3.980553032501898*^9}, {
  3.98055312961891*^9, 3.980553188386627*^9}, {3.980553421215412*^9, 
  3.9805534583041477`*^9}, {3.980553515787979*^9, 3.9805536344994984`*^9}, {
  3.980553715584963*^9, 
  3.980553793403*^9}},ExpressionUUID->"61746734-8444-fe41-9c40-af682b19e29d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "compute", " ", "the", " ", "Petz", " ", 
    "Recovery", " ", "Map", " ", "Superoperator"}], "*)"}], 
  RowBox[{
   RowBox[{"PetzMapSuperoperator", "[", 
    RowBox[{
     RowBox[{"S_", "?", "MatrixQ"}], ",", 
     RowBox[{"sigma_", "?", "MatrixQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dim", ",", "sigmaVec", ",", "NsigmaVec", ",", "Nsigma", ",", 
       "NsigmaInvHalf", ",", "sigmaHalf", ",", "preMult", ",", "postMult", ",",
        "SAdjoint"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Deduce", " ", "the", " ", "Hilbert", " ", "space", " ", 
       "dimension", " ", "from", " ", "the", " ", "superoperator", " ", "S"}],
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Length", "[", "S", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "2.", " ", "Evolve", " ", "the", " ", "reference", " ", "state", " ", 
        "sigma", " ", "through", " ", "the", " ", "channel"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"sigmaVec", "=", 
       RowBox[{"Flatten", "[", "sigma", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"NsigmaVec", "=", 
       RowBox[{"S", ".", "sigmaVec"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Nsigma", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"NsigmaVec", ",", "dim"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "3.", " ", "Calculate", " ", "the", " ", "necessary", " ", "matrix", " ",
         "powers"}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"Note", ":", 
        RowBox[{
         RowBox[{
         "We", " ", "use", " ", "PseudoInverse", " ", "on", " ", "the", " ", 
          "square", " ", "root", " ", "to", " ", "safely", " ", "handle", " ",
           "cases", " ", "where", " ", "N", 
          RowBox[{"(", "sigma", ")"}], " ", "might", " ", "be", " ", "rank"}],
          "-", 
         RowBox[{"deficient", "."}]}]}], "*)"}], 
      RowBox[{"NsigmaInvHalf", "=", 
       RowBox[{"PseudoInverse", "[", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"Nsigma", ",", 
          RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sigmaHalf", "=", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"sigma", ",", 
         RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"4.", " ", "Construct", " ", "the", " ", "pre"}], "-", 
        RowBox[{"and", " ", "post"}], "-", 
        RowBox[{"multiplication", " ", "superoperators"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{"Rule", ":", 
        RowBox[{
        "A", " ", "\[Rho]", " ", "B", " ", "is", " ", "represented", " ", 
         "by", " ", 
         RowBox[{"A", "\[TensorProduct]", 
          RowBox[{"B", "^", "T"}]}]}]}], "*)"}], 
      RowBox[{"preMult", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"NsigmaInvHalf", ",", 
         RowBox[{"Transpose", "[", "NsigmaInvHalf", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"postMult", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"sigmaHalf", ",", 
         RowBox[{"Transpose", "[", "sigmaHalf", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"5.", " ", "Adjoint", " ", "of", " ", "the", " ", 
        RowBox[{"channel", "'"}], "s", " ", "superoperator"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"SAdjoint", "=", 
       RowBox[{"ConjugateTranspose", "[", "S", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "6.", " ", "Combine", " ", "everything", " ", "via", " ", "matrix", " ",
         "multiplication"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"postMult", ".", "SAdjoint", ".", "preMult"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9805549871031456`*^9, 3.9805550063461018`*^9}, {
  3.9805550453915195`*^9, 3.980555048469021*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"015fcb83-a220-b34c-b4ef-a48fa9866770"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]a", "=", 
   RowBox[{"ampdampLiouville", "/.", 
    RowBox[{"p", "->", "0.1"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalOmega]b", "=", 
    RowBox[{"phdampLiouville", "/.", 
     RowBox[{"p", "->", "0.1"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Recover", " ", "the", " ", "Phase", " ", 
    RowBox[{"Damping", " ", "[", "WRONG", "]"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P1", "=", 
    RowBox[{"PetzMapSuperoperator", "[", 
     RowBox[{"\[CapitalOmega]b", ",", "\[Rho]0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Update", " ", "the", " ", "noises"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Na", "=", 
   RowBox[{"\[CapitalOmega]a", ".", "P1", ".", "\[CapitalOmega]a"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Nb", "=", 
    RowBox[{"\[CapitalOmega]b", ".", "P1", ".", "\[CapitalOmega]b"}]}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Check", " ", "that", " ", "it", " ", "is", " ", "truly", " ", 
    "recovering", " ", "the", " ", "Phase", " ", "Damping", " ", "Noise"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Fidelity", "[", 
  RowBox[{"\[Rho]0", ",", 
   RowBox[{"UnVectorize", "[", 
    RowBox[{"P1", ".", "\[CapitalOmega]a", ".", 
     RowBox[{"Vectorize", "[", "\[Rho]0", "]"}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Fidelity", "[", 
  RowBox[{"\[Rho]0", ",", 
   RowBox[{"UnVectorize", "[", 
    RowBox[{"P1", ".", "\[CapitalOmega]b", ".", 
     RowBox[{"Vectorize", "[", "\[Rho]0", "]"}]}], "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9805540513613033`*^9, 3.9805541441588135`*^9}, {
  3.9805543278105297`*^9, 3.980554387747549*^9}, {3.980554526110918*^9, 
  3.9805546913902493`*^9}, {3.9805550629598866`*^9, 3.9805550662501125`*^9}, {
  3.980555099037508*^9, 3.9805551393345146`*^9}, {3.980555239755745*^9, 
  3.9805552676192875`*^9}, {3.9805553545645065`*^9, 3.9805553771860447`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"d6b2ffdf-57e8-8248-8f1d-1c8231eb2c42"],

Cell[BoxData["0.9927324595955802`"], "Output",
 CellChangeTimes->{3.9805553783320637`*^9},
 CellLabel->
