Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Helper", " ", "Functions"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Vectorize", "[", "rho_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Transpose", "[", "rho", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UnVectorize", "[", "rho_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "rowVec", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rowVec", "=", 
        RowBox[{"Flatten", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Partition", "[", 
         RowBox[{"rowVec", ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "[", "rowVec", "]"}], "]"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Checks", " ", "if"}], "||", 
     RowBox[{"m1", "-", "m2"}], "||", " ", 
     RowBox[{"<", "tolerance"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IsMatrixClose", "[", 
     RowBox[{"m1_", ",", "m2_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Norm", "[", 
      RowBox[{"m1", "-", "m2"}], "]"}], "<", "tol"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "2.", " ", "Compute", " ", "Quantum", " ", "Fidelity", " ", "F"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Tr", "|", 
        RowBox[{"sqrt", 
         RowBox[{
          RowBox[{"(", "rho", ")"}], ".", "sigma", ".", "sqrt"}], 
         RowBox[{"(", "rho", ")"}]}], "|"}], ")"}], "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Fidelity", "[", 
      RowBox[{"rho_", ",", "sigma_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", ",", "s", ",", "prod", ",", "traceVal"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"Chop", "[", "rho", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"s", "=", 
         RowBox[{"Chop", "[", "sigma", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"prod", "=", 
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"r", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}], ".", "s", ".", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"r", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"traceVal", "=", 
         RowBox[{"Tr", "[", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"prod", ",", 
            RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Abs", "[", "traceVal", "]"}], "^", "2"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9800743882785797`*^9, 3.980074456543476*^9}, {
  3.980074530380436*^9, 3.9800746049117126`*^9}, {3.9800755046264668`*^9, 
  3.9800755050601635`*^9}, {3.980075571043398*^9, 3.980075631183815*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"5cb15b75-9cee-df46-93ec-8a0c0e729748"],

