Cell[CellGroupData[{

Cell["2. Find the Petz Kraus Operators", "Section",
 CellChangeTimes->{{3.9799931466443577`*^9, 
  3.979993157302578*^9}},ExpressionUUID->"53065a1c-5aa3-2d48-956c-\
4e10aaaaf1a5"],

Cell[TextData[{
 "Given some noise ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{N}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e033d5d2-fb53-a548-a428-f8d1df9babb9"],
 ", the Petz Map ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["N", "TI"], ",", "\[Sigma]"}]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathcal{P}_{\\mathcal{N},\\sigma}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "20d8374e-2d36-d946-a961-82905fcaa2cb"],
 " for the state ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|
     "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\sigma", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "46253940-d1e5-f34b-9ca9-f57b4fd1f192"],
 " is defined as:  \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["N", "TI"], ",", "\[Sigma]"}]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          FractionBox["1", "2"]], 
         SuperscriptBox[
          StyleBox["N", "TI"], "\[Dagger]"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["N", "TI"], 
             SuperscriptBox[
              RowBox[{"(", "\[Sigma]", ")"}], 
              RowBox[{"-", 
                FractionBox["1", "2"]}]], "\[Rho]", 
             StyleBox["N", "TI"], 
             SuperscriptBox[
              RowBox[{"(", "\[Sigma]", ")"}], 
              RowBox[{"-", 
                FractionBox["1", "2"]}]]}], ")"}], 
         SuperscriptBox["\[Sigma]", 
          FractionBox["1", "2"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{P}_{\\mathcal{N},\\sigma} = \\sigma^\\frac{1}{2}\\mathcal{N}^\
\\dagger\\left( \\mathcal{N}(\\sigma)^{-\\frac{1}{2}} \\rho \
\\mathcal{N}(\\sigma)^{-\\frac{1}{2}} \\right)\\sigma^\\frac{1}{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dcbca0b-38e9-f943-aa76-bda2c8d6e2b3"],
 " .\nThis can be defined by its own set of Kraus Operators ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["R", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "R_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48a9836b-c951-4b41-9a31-e7e1392c2e0d"],
 ", starting from the Kraus Operators ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["K", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "K_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1c5dfe5-b944-4445-8aa4-48b843a7e966"],
 " of the forward map:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          FractionBox["1", "2"]], 
         SubsuperscriptBox[
          StyleBox["K", "TI"], 
          StyleBox["k", "TI"], "\[Dagger]"], 
         StyleBox["N", "TI"], 
         SuperscriptBox[
          RowBox[{"(", "\[Sigma]", ")"}], 
          RowBox[{"-", 
            FractionBox["1", "2"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "R_k = \\sigma^\\frac{1}{2}K_k^\\dagger \
\\mathcal{N}(\\sigma)^{-\\frac{1}{2}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ebd8203-115f-7f42-8f1c-8aa1b4ff0698"]
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 TaggingRules-><|"ChatNotebookSettings" -> <||>|>,
 CellChangeTimes->{{3.980218474996027*^9, 3.980218550715904*^9}, 
   3.9802186058151684`*^9, 3.980218661848322*^9, {3.980218869690834*^9, 
   3.980218911876625*^9}, {3.980218969028425*^9, 3.980219011595869*^9}},
 Background->GrayLevel[
  0.5],ExpressionUUID->"f567f32c-540f-f846-b4f7-9e10903500c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PetzKrausOperators", "[", 
   RowBox[{"krausFwd_", ",", "sigma_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sigmaOut", ",", "invSqrtSigmaOut", ",", "sqrtSigma", ",", "petzK"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"sigmaOut", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"k", ".", "sigma", ".", 
          RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "krausFwd"}], "}"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"invSqrtSigmaOut", "=", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"sigmaOut", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sqrtSigma", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{"sigma", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"petzK", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sqrtSigma", ".", 
         RowBox[{"ConjugateTranspose", "[", "k", "]"}], ".", 
         "invSqrtSigmaOut"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "krausFwd"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "petzK"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bitflipKrausRec", "=", 
   RowBox[{"PetzKrausOperators", "[", 
    RowBox[{"bitflipKraus", ",", " ", "\[Rho]0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dephasingKrausRec", "=", 
   RowBox[{"PetzKrausOperators", "[", 
    RowBox[{"dephasingKraus", ",", "\[Rho]0"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9799931650297775`*^9, 3.9799932144653816`*^9}, {
  3.979993327458332*^9, 3.9799933894442806`*^9}, {3.979993742399685*^9, 
  3.9799937651595306`*^9}, {3.9799939182404575`*^9, 3.9799939218324604`*^9}, {
  3.9799940938412113`*^9, 3.979994135567545*^9}, {3.9799945518630047`*^9, 
  3.979994600618618*^9}, {3.980075757168207*^9, 3.980075776814144*^9}},
 CellLabel->
  "In[540]:=",ExpressionUUID->"46c57c51-5973-5642-a394-4c6cfc4b3415"],

