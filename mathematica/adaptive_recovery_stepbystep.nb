Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Bitflip", " ", "Channel"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"BitflipKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k0", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "p"}], "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", " ", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", "p", "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k0", ",", "k1"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Dephasing", " ", "Channel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DephasingKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k0", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "p"}], "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", " ", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", "p", "]"}], " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k0", ",", "k1"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Amplitude", " ", "Damping", " ", "Channel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AmplitudeDampingKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k0", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", "p"}], "]"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sqrt", "[", "p", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k0", ",", "k1"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Phase", " ", "Damping", " ", "Channel", " ", 
     RowBox[{"(", "T2", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"PhaseDampingKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"k0", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", "p"}], "]"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sqrt", "[", "p", "]"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"k0", ",", "k1"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Depolarizing", " ", "Channel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DepolarizingKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1", ",", "k2", ",", "k3", ",", "f"}], "}"}], ",", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"p", "/", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"k0", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "p"}], "]"}], "*", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{"f", "*", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ";", 
       RowBox[{"k2", "=", 
        RowBox[{"f", "*", 
         RowBox[{"PauliMatrix", "[", "2", "]"}]}]}], ";", 
       RowBox[{"k3", "=", 
        RowBox[{"f", "*", 
         RowBox[{"PauliMatrix", "[", "3", "]"}]}]}], ";", 
       RowBox[{"{", 
        RowBox[{"k0", ",", "k1", ",", "k2", ",", "k3"}], "}"}]}]}], 
