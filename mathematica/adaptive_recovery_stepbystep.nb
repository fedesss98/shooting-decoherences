Cell[BoxData[
 RowBox[{
  RowBox[{"KrausToLiouville", "[", "kraus_", "]"}], ":=", 
  RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"k", ",", 
       RowBox[{"Conjugate", "[", "k", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "kraus"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
