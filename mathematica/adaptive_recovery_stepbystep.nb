Cell["\<\
Apply Noise to the state and Recover it.
We can recover using Kraus Operators of the Liouville Operator:\
\>", "Text",
 CellChangeTimes->{{3.9800756814179688`*^9, 3.980075689519499*^9}, {
  3.9802191127700825`*^9, 
  3.9802191425689754`*^9}},ExpressionUUID->"faf0e8a5-d350-db46-9638-\
a06c8d94a731"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalOmega]1", "=", "bitflipLiouville"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P1", "=", "bitflipLiouvilleRec"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]noisy", "=", 
    RowBox[{"ApplyMap", "[", 
     RowBox[{"\[CapitalOmega]1", ",", "\[Rho]0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Using", " ", "Recovery", " ", "Kraus", " ", "Operators"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]out", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"k", ".", "\[Rho]noisy", ".", 
      RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "bitflipKrausRec"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Fidelity of Kraus Recovery: \>\"", ",", " ", 
    RowBox[{"Fidelity", "[", 
     RowBox[{"\[Rho]0", ",", "\[Rho]out"}], "]"}]}], "]"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Using", " ", "the", " ", "Liouville", " ", "Operator"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]out", "=", 
   RowBox[{"UnVectorize", "[", 
    RowBox[{"P1", ".", 
     RowBox[{"Vectorize", "[", "\[Rho]noisy", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Fidelity of Liouville Recovery: \>\"", ",", " ", 
   RowBox[{"Fidelity", "[", 
    RowBox[{"\[Rho]0", ",", "\[Rho]out"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Recovered \[Rho] = \>\"", ",", " ", 
   RowBox[{"\[Rho]out", "//", "MatrixForm"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9800740925732956`*^9, 3.9800742515328007`*^9}, 
   3.980074326832777*^9, {3.980074615940508*^9, 3.980074693789732*^9}, {
