Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "=", "0.4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "/@", "bitflipKrausRec"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "/@", "dephasingKrausRec"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bitflipLiouvilleRec", "=", 
   RowBox[{"KrausToLiouville", "[", "bitflipKrausRec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Bitflip Liouville =   \>\"", ",", 
   RowBox[{"bitflipLiouvilleRec", "//", "MatrixForm"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dephasingLiouvilleRec", "=", 
   RowBox[{"KrausToLiouville", "[", "dephasingKrausRec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Dephasing Liouville = \>\"", ",", 
