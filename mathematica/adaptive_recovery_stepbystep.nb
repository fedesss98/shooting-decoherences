Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Fix", " ", "the", " ", "real", " ", "Noise", " ", "acting", " ", "over", " ",
     "the", " ", "system"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalOmega]", "=", "bitflipLiouville"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P1", "=", "bitflipLiouvilleRec"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P2", "=", "dephasingLiouvilleRec"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]noisy", "=", 
     RowBox[{"UnVectorize", "[", 
      RowBox[{"\[CapitalOmega]1", ".", 
       RowBox[{"Vectorize", "[", "\[Rho]0", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Using", " ", "Recovery", " ", "Kraus", " ", "Operators"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]out1", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"k", ".", "\[Rho]noisy", ".", 
        RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "bitflipKrausRec"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]out2", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"k", ".", "\[Rho]noisy", ".", 
        RowBox[{"ConjugateTranspose", "[", "k", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "dephasingKrausRec"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<--- Using Kraus Operators ---\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Fidelity of Correct Recovery (P[\[CapitalOmega]1]): \>\"", ",",
      " ", 
     RowBox[{"Fidelity", "[", 
      RowBox[{"\[Rho]0", ",", "\[Rho]out1"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Fidelity of Wrong Recovery (P[\[CapitalOmega]2]): \>\"", ",",
      " ", 
     RowBox[{"Fidelity", "[", 
      RowBox[{"\[Rho]0", ",", "\[Rho]out2"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Using", " ", "the", " ", "Liouville", " ", "Operator"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]out1", "=", 
     RowBox[{"UnVectorize", "[", 
      RowBox[{"P1", ".", 
       RowBox[{"Vectorize", "[", "\[Rho]noisy", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Rho]out2", "=", 
     RowBox[{"UnVectorize", "[", 
      RowBox[{"P2", ".", 
       RowBox[{"Vectorize", "[", "\[Rho]noisy", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<--- Using Liouville Matrix ---\>\"", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Fidelity of Correct Recovery (P[\[CapitalOmega]1]): \>\"", ",",
