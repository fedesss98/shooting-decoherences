   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Depolarizing", " ", "Channel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DepolarizingKraus", "[", "p_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k0", ",", "k1", ",", "k2", ",", "k3", ",", "f"}], "}"}], ",", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"p", "/", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"k0", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", "p"}], "]"}], "*", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{"f", "*", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}]}], ";", 
       RowBox[{"k2", "=", 
        RowBox[{"f", "*", 
