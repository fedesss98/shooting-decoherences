       "\[IndentingNewLine]", 
       RowBox[{"k1", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"Sqrt", "[", "p", "]"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
