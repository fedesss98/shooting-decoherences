Cell["We are trying to recovery states from the Bitflip Error", "Text",
 CellChangeTimes->{{3.9759869288880463`*^9, 
  3.975986951363636*^9}},ExpressionUUID->"df83685a-b8d7-1946-9b14-\
7006716cac8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Probability", " ", "of", " ", "Bitflip", " ", "at", " ", "time", " ", 
    "\[Tau]", " ", "given", " ", "interaction", " ", "force", " ", 
    "\[CapitalGamma]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"\[CapitalGamma]_", ",", "\[Tau]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "*", "\[CapitalGamma]", "*", "\[Tau]"}], "]"}]}],
       ")"}], "/", "2"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"In", " ", "the", " ", "paper"}], ",", " ", 
     RowBox[{
     "they", " ", "fix", " ", "px", " ", "to", " ", "be", " ", "0.05"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalGamma]", "=", "0.0526806"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"t", "=", "1.0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"px", "=", 
    RowBox[{"p", "[", 
     RowBox[{"\[CapitalGamma]", ",", "t"}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9759869554353275`*^9, 3.975987095112295*^9}, {
  3.9759871406099663`*^9, 3.975987222296047*^9}},
 CellLabel->
  "In[325]:=",ExpressionUUID->"df25c83c-edc6-7d4a-a5a3-f5e812946b34"],

Cell[BoxData["0.05000030795387278`"], "Output",
 CellChangeTimes->{{3.97598713269084*^9, 3.9759872232340546`*^9}, 
   3.9759900437987385`*^9, 3.976003548747608*^9, 3.976004377129442*^9, 
   3.9760068651710606`*^9, 3.9760076614740047`*^9},
 CellLabel->
