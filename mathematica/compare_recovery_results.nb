Cell[CellGroupData[{
Cell["Comparing Results", "Title",
 CellChangeTimes->{{3.9759867272715225`*^9, 
  3.9759867572036953`*^9}},ExpressionUUID->"cb140815-0596-db42-9982-\
1eef142496a3"],

Cell["\<\
We  want to understand the Results in the \[OpenCurlyDoubleQuote]Reversing \
Dynamics\[CloseCurlyDoubleQuote] paper and compare them with ours\
\>", "Text",
 CellChangeTimes->{{3.975986762775551*^9, 
  3.9759867905721836`*^9}},ExpressionUUID->"eaab5ae2-407e-d341-b147-\
b9395960ca72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nQubits", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nDims", "=", 
   SuperscriptBox["2", "nQubits"]}], ";"}]}], "Input",
 CellChangeTimes->{{3.975986897138294*^9, 3.975986921414669*^9}, {
  3.9759877082865047`*^9, 3.9759877083144264`*^9}, {3.9759895873197575`*^9, 
  3.975989587373911*^9}, {3.9759899829653187`*^9, 3.9759899836420765`*^9}, {
