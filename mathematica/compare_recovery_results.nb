 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Evolve", " ", "the", " ", "state"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]1", "=", 
     RowBox[{"\[CapitalLambda]", "[", 
