Cell[CellGroupData[{

Cell["Petz Recovery Map", "Section",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9719536171391373`*^9, 
  3.971953667614519*^9}},ExpressionUUID->"986e23b2-b9aa-b541-88d2-\
5a2199e55d6e"],

Cell[TextData[{
 "The recovery map is defined as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{"\[Sigma]", ",", "\[CapitalLambda]"}]], 
         RowBox[{"[", "\[Rho]", "]"}], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]], "\[Rho]\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{P}_{\\sigma,\\Lambda}[\\rho]=\\sigma^{1/2}\\Lambda^\\dagger\\\
left[\\Lambda[\\sigma]^{-1/2} \\rho \\Lambda[\\sigma]^{-1/2} \
\\right]\\sigma^{1/2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27e85b6b-c729-e44b-936b-4b00c6ab8c78"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", 
         RowBox[{"[", "\[Sigma]", "]"}], "\[LongEqual]", "\[Sigma]", 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda[\\sigma]=\\sigma(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6e3c2ff-c101-3f43-84fc-75c17d0ee0cb"],
 ", such that:\n    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{"\[Sigma]", ",", "\[CapitalLambda]"}]], 
         RowBox[{"[", 
           RowBox[{"\[Sigma]", "(", 
             StyleBox["t", "TI"], ")"}], "]"}], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]], "\[Sigma]", 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], "\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[Sigma]", 
             SuperscriptBox[
              RowBox[{"(", 
                StyleBox["t", "TI"], ")"}], 
              RowBox[{"-1", "/", "2"}]], "\[Sigma]", 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], "\[Sigma]", 
             SuperscriptBox[
              RowBox[{"(", 
                StyleBox["t", "TI"], ")"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           StyleBox["I", FontSlant -> "Plain"], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", "\[Sigma]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{P}_{\\sigma,\\Lambda}[\\sigma(t)]=\\sigma^{1/2}\\Lambda^\\\
dagger\\left[\\Lambda[\\sigma]^{-1/2} \\sigma(t) \\Lambda[\\sigma]^{-1/2} \
\\right]\\sigma^{1/2} = \
\\sigma^{1/2}\\Lambda^\\dagger\\left[\\sigma(t)^{-1/2} \\sigma(t) \
\\sigma(t)^{-1/2} \\right]\\sigma^{1/2}=\\sigma^{1/2}\\Lambda^\\dagger\\left[\
\\mathbb{I} \\right]\\sigma^{1/2}=\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6cc19b20-1caa-4e45-af84-cbc0d0464b7c"],
 "\[AliasDelimiter]\n(we reversed the time evolution from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\sigma(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ef10f4d-da4b-af4a-8918-701626d01696"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dcac00a-9f50-da4b-9a5a-0b6e36afefe1"],
 "."
}], "Text",
 CellChangeTimes->{{3.9719536877286854`*^9, 3.9719537094862537`*^9}, {
   3.9719538576469135`*^9, 3.9719538733365765`*^9}, {3.971953947184614*^9, 
   3.9719539735512047`*^9}, {3.9719540720492935`*^9, 
   3.9719540728801804`*^9}, {3.971954118031122*^9, 3.971954154735985*^9}, 
   3.972025940371729*^9},ExpressionUUID->"3df5b308-30a2-6b45-b199-\
c1d2b61f48d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalLambda]", "[", 
   RowBox[{"Ks_", ",", "\[Rho]0_"}], "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", ".", "\[Rho]0", ".", 
       RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
    "Ks"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPi]", "[", 
   RowBox[{"Ks_", ",", "X_"}], "]"}], ":=", 
  RowBox[{"Total", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "X", ".", "#"}], 
      ")"}], "&"}], "/@", "Ks"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9759875167956276`*^9, 3.975987601796053*^9}, {
  3.9759877990573025`*^9, 3.9759877998448143`*^9}, {3.976003913563368*^9, 
  3.9760039746001205`*^9}},
 CellLabel->
  "In[333]:=",ExpressionUUID->"fb12a0fe-6d42-004d-a962-e229e7cea03b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Petz", "[", 
   RowBox[{"Ks_", ",", "\[Sigma]_", ",", "\[Rho]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "innerMatrix", ",", "Phi", ",", "PhiAdj", ",", "sqrt\[Sigma]", ",", 
      "sqrt\[Sigma]t", ",", "recovered"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Standard", " ", "forward"}], "-", 
      RowBox[{"time", " ", "map"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "rho_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", ".", "rho", ".", 
           RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "&"}], "/@",
         "Ks"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Adjoint", " ", "map"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PhiAdj", "[", "X_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "X", ".", 
           "#"}], ")"}], "&"}], "/@", "Ks"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sqrt\[Sigma]", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{"\[Sigma]", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sqrt\[Sigma]t", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"Phi", "[", "\[Sigma]", "]"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"innerMatrix", "=", 
      RowBox[{"sqrt\[Sigma]t", ".", "\[Rho]", ".", "sqrt\[Sigma]t"}]}], " ", ";",
      "\[IndentingNewLine]", 
     RowBox[{"recovered", "=", 
      RowBox[{"sqrt\[Sigma]", ".", 
       RowBox[{"PhiAdj", "[", "innerMatrix", "]"}], ".", "sqrt\[Sigma]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Simplify", "[", "recovered", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9719541740655136`*^9, 3.9719544300648327`*^9}, {
   3.971954487633623*^9, 3.9719544948319836`*^9}, {3.9719546840160007`*^9, 
   3.9719547062560654`*^9}, {3.971954763472767*^9, 3.9719548769293365`*^9}, {
