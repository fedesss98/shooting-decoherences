Cell[TextData[{
 "Those states belong to the code space, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "|", "\[Psi]", "\[RightAngleBracket]", "\[LongEqual]", "\[Alpha]", 
         "|00...0", "\[RightAngleBracket]", "+", "\[Beta]", "|11...1", 
         "\[RightAngleBracket]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\psi\\rangle=\\alpha|00...0\\rangle +\\beta|11...1\\rangle", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "018a3ff3-73a8-024d-8133-7b6fb69bb176"]
}], "Text",
 CellChangeTimes->{{3.9759908194081974`*^9, 3.975990869263241*^9}, {
  3.97599090111339*^9, 3.9759909037929897`*^9}, {3.9759909368106155`*^9, 
  3.975990946588724*^9}},ExpressionUUID->"8f8ba796-d45e-6f40-bf62-\
3ef8cebd84f0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"codeSpaceState", "[", 
   RowBox[{"dims_", ",", "\[Alpha]_", ",", "\[Beta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"stateBasis", ",", "\[Psi]"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"stateBasis", " ", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", "dims"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"stateBasis", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"stateBasis", "[", 
       RowBox[{"[", "dims", "]"}], "]"}], "=", "1"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"Normalize", "[", 
       RowBox[{
        RowBox[{"\[Alpha]", "*", "stateBasis"}], "+", 
        RowBox[{"\[Beta]", "*", "stateBasis"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "\[Psi]", ",", 
       RowBox[{"Conjugate", "[", "\[Psi]", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"codeSpaceStateR", "[", "dims_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "stateBasis", ",", "\[Psi]"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"RandomComplex", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[Alpha]", "2"]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"stateBasis", " ", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"0", ",", "dims"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"stateBasis", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "=", "\[Alpha]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"stateBasis", "[", 
       RowBox[{"[", "dims", "]"}], "]"}], "=", "\[Beta]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"Normalize", "[", "stateBasis", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "\[Psi]", ",", 
       RowBox[{"Conjugate", "[", "\[Psi]", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{
