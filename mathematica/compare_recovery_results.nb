}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"k1", " ", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2", "=", 
   RowBox[{"PauliMatrix", "[", "1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K1", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"k1", ",", "#"}], "]"}], "&"}], ",", "k1", ",", 
     RowBox[{"nQubits", "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K2", "=", 
   RowBox[{"Nest", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{"k2", ",", "#"}], "]"}], "&"}], ",", "k2", ",", 
     RowBox[{"nQubits", "-", "1"}]}], "]"}]}], ";", 
  RowBox[{"kraus", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", "px"}], "]"}], "*", "K1"}], ",", " ", 
     RowBox[{
      RowBox[{"Sqrt", "[", "px", "]"}], "*", "K2"}]}], "}"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9759872322813377`*^9, 3.9759873109482937`*^9}, {
   3.9759874388625736`*^9, 3.975987477439432*^9}, {3.9759887981032887`*^9, 
   3.9759887984142456`*^9}, {3.9759891199635944`*^9, 3.975989126113268*^9}, 
   3.975989235905035*^9, {3.9759897375783806`*^9, 3.9759897690505657`*^9}, 
   3.975989869374508*^9, {3.9759899072466583`*^9, 3.9759899106979866`*^9}, {
   3.9759899903111877`*^9, 3.975990108521389*^9}, {3.9759901584876137`*^9, 
   3.9759901839419365`*^9}, {3.9759902239654236`*^9, 
   3.9759902258501225`*^9}, {3.976006810153467*^9, 3.9760068281442547`*^9}},
 CellLabel->
