Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalLambda]", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k1t", ",", "k2t", ",", "\[Rho]t"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"k1t", "=", 
      RowBox[{"k1", "/.", 
       RowBox[{"\[Tau]", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k2t", "=", 
      RowBox[{"k2", "/.", 
       RowBox[{"\[Tau]", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]t", "=", 
      RowBox[{
       RowBox[{"k1t", ".", "x", ".", 
        RowBox[{"ConjugateTranspose", "[", "k1t", "]"}]}], " ", "+", " ", 
       RowBox[{"k2t", ".", "x", ".", 
        RowBox[{"ConjugateTranspose", "[", "k2t", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Simplify", "[", "\[Rho]t", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9719531927083626`*^9, 3.971953368545927*^9}, 
   3.9720255674275513`*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"191eabfb-4468-c541-af8d-b61e50b89574"],

