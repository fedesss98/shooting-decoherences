Cell[CellGroupData[{

Cell["Petz Recovery Map", "Section",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.9719536171391373`*^9, 
  3.971953667614519*^9}},ExpressionUUID->"30ddd269-2b5b-464e-bbec-\
3a0ac2d4771e"],

Cell[TextData[{
 "The recovery map is defined as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{"\[Sigma]", ",", "\[CapitalLambda]"}]], 
         RowBox[{"[", "\[Rho]", "]"}], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]], "\[Rho]\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{P}_{\\sigma,\\Lambda}[\\rho]=\\sigma^{1/2}\\Lambda^\\dagger\\\
left[\\Lambda[\\sigma]^{-1/2} \\rho \\Lambda[\\sigma]^{-1/2} \
\\right]\\sigma^{1/2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2668316b-ff7e-4845-b54c-5f494054c264"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalLambda]", 
         RowBox[{"[", "\[Sigma]", "]"}], "\[LongEqual]", "\[Sigma]", 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda[\\sigma]=\\sigma(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebc529c6-a17e-9f45-97c0-8e42e3898bfc"],
 ", such that:\n    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{"\[Sigma]", ",", "\[CapitalLambda]"}]], 
         RowBox[{"[", 
           RowBox[{"\[Sigma]", "(", 
             StyleBox["t", "TI"], ")"}], "]"}], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]], "\[Sigma]", 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], "\[CapitalLambda]", 
             SuperscriptBox[
              RowBox[{"[", "\[Sigma]", "]"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           RowBox[{"\[Sigma]", 
             SuperscriptBox[
              RowBox[{"(", 
                StyleBox["t", "TI"], ")"}], 
              RowBox[{"-1", "/", "2"}]], "\[Sigma]", 
             RowBox[{"(", 
               StyleBox["t", "TI"], ")"}], "\[Sigma]", 
             SuperscriptBox[
              RowBox[{"(", 
                StyleBox["t", "TI"], ")"}], 
              RowBox[{"-1", "/", "2"}]]}], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], 
         SuperscriptBox["\[CapitalLambda]", "\[Dagger]"], 
         RowBox[{"[", 
           StyleBox["I", FontSlant -> "Plain"], "]"}], 
         SuperscriptBox["\[Sigma]", 
          RowBox[{"1", "/", "2"}]], "\[LongEqual]", "\[Sigma]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{P}_{\\sigma,\\Lambda}[\\sigma(t)]=\\sigma^{1/2}\\Lambda^\\\
dagger\\left[\\Lambda[\\sigma]^{-1/2} \\sigma(t) \\Lambda[\\sigma]^{-1/2} \
\\right]\\sigma^{1/2} = \
\\sigma^{1/2}\\Lambda^\\dagger\\left[\\sigma(t)^{-1/2} \\sigma(t) \
\\sigma(t)^{-1/2} \\right]\\sigma^{1/2}=\\sigma^{1/2}\\Lambda^\\dagger\\left[\
\\mathbb{I} \\right]\\sigma^{1/2}=\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9457b9b-4fd9-7a44-b127-9affa3a56f59"],
 "\[AliasDelimiter]\n(we reversed the time evolution from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\sigma(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ef99a9a-c63b-d24d-a6f1-3286a5d88a20"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "acdaf659-c96c-a341-9dec-44ab0194bca2"],
 "."
}], "Text",
 CellChangeTimes->{{3.9719536877286854`*^9, 3.9719537094862537`*^9}, {
   3.9719538576469135`*^9, 3.9719538733365765`*^9}, {3.971953947184614*^9, 
   3.9719539735512047`*^9}, {3.9719540720492935`*^9, 
   3.9719540728801804`*^9}, {3.971954118031122*^9, 3.971954154735985*^9}, 
   3.972025940371729*^9},ExpressionUUID->"a5120c3a-9692-764a-b4da-\
41757d22c138"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Petz", "[", 
   RowBox[{"Ks_", ",", "t_", ",", "\[Sigma]_", ",", "\[Rho]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "innerMatrix", ",", "Phi", ",", "PhiAdj", ",", "sqrt\[Sigma]", ",", 
      "sqrt\[Sigma]t", ",", "recovered"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "rho_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", ".", "rho", ".", 
            RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "&"}], "/@",
          "Ks"}], "/.", 
        RowBox[{"\[Tau]", "->", "t"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PhiAdj", "[", "X_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "X", ".", 
            "#"}], ")"}], "&"}], "/@", "Ks"}], "/.", 
        RowBox[{"\[Tau]", "->", "t"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sqrt\[Sigma]", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{"\[Sigma]", ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sqrt\[Sigma]t", "=", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"Phi", "[", "\[Sigma]", "]"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"innerMatrix", "=", 
      RowBox[{"sqrt\[Sigma]t", ".", "\[Rho]", ".", "sqrt\[Sigma]t"}]}], " ", ";",
      "\[IndentingNewLine]", 
     RowBox[{"recovered", "=", 
      RowBox[{"sqrt\[Sigma]", ".", 
       RowBox[{"PhiAdj", "[", "innerMatrix", "]"}], ".", "sqrt\[Sigma]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Simplify", "[", "recovered", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9719541740655136`*^9, 3.9719544300648327`*^9}, {
   3.971954487633623*^9, 3.9719544948319836`*^9}, {3.9719546840160007`*^9, 
   3.9719547062560654`*^9}, {3.971954763472767*^9, 3.9719548769293365`*^9}, {
   3.971954953840044*^9, 3.971955043839327*^9}, {3.971955084562212*^9, 
   3.971955085073471*^9}, {3.971955149635439*^9, 3.9719551881127377`*^9}, {
   3.9719553434403324`*^9, 3.9719553735994015`*^9}, {3.9719554158731613`*^9, 
   3.9719554229780483`*^9}, {3.9719556534382114`*^9, 
   3.9719556870210094`*^9}, {3.972020833177561*^9, 3.9720209810829544`*^9}, {
   3.9720218740090637`*^9, 3.972021917960079*^9}, {3.972022155959156*^9, 
   3.9720221564550056`*^9}, 3.9720243066941013`*^9, {3.972026268675499*^9, 
   3.972026272436249*^9}, {3.9720276052828426`*^9, 3.972027615319132*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"577d171b-2cdb-f849-9544-8370465723ea"],

Cell[CellGroupData[{

Cell["Proof that this map recovers an initial state", "Subsection",
 CellChangeTimes->{{3.972027482292139*^9, 
  3.9720275068489265`*^9}},ExpressionUUID->"152092a9-2fce-8542-91a9-\
c45839aa5ea9"],

Cell["\<\
We go back from \[Rho]s evolved for a time s to the initial state \[Rho].\
\>", "Text",
 CellChangeTimes->{{3.972027509156561*^9, 3.9720275587540474`*^9}, {
  3.972027665298897*^9, 
  3.9720276755694847`*^9}},ExpressionUUID->"b4094c9b-c098-ce45-9670-\
1b9d3d05a876"],

