Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]r", "=", 
   RowBox[{"Petz", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k1", ",", "k2"}], "}"}], ",", "s", ",", "\[Rho]", ",", 
     "\[Rho]s"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]r", "==", "\[Rho]"}]}], "Input",
 CellChangeTimes->{{3.9720275613169537`*^9, 3.972027602626953*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"d0d3420c-47f5-7a47-8ad8-c4945d00a1c3"],

