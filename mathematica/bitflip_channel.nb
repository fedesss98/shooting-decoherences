Cell[TextData[{
 "Now we check that this is equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["t", "TI"], "+", 
            StyleBox["s", "TI"], ",", "0"}]], 
         RowBox[{"[", "\[Rho]", "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda_{t+s,0}[\\rho]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e38e5cb-b63b-e84d-966e-b662a439f485"],
 ","
}], "Text",
 CellChangeTimes->{{3.9719535392485275`*^9, 
  3.9719535732190437`*^9}},ExpressionUUID->"66f5d8b3-30ab-4846-9d18-\
acd9cb9f00e8"],

