 RowBox[{
  RowBox[{"\[Rho]r", "=", 
   RowBox[{"Petz", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k1", ",", "k2"}], "}"}], ",", "s", ",", "\[Rho]", ",", 
     "\[Rho]s"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"\[Rho]r", "==", "\[Rho]"}]}], "Input",
