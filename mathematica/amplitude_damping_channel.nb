Notebook[{

Cell[CellGroupData[{
Cell["Amplitude Damping Channel", "Title",
 CellChangeTimes->{{3.971951058884329*^9, 
  3.9719510746263065`*^9}},ExpressionUUID->"d6bac704-fc44-8d4a-a056-\
e257488f5b76"],

Cell[CellGroupData[{

Cell["Prove that it forms a Semigroup", "Section",
 CellChangeTimes->{{3.9719510794737663`*^9, 
  3.9719511123550644`*^9}},ExpressionUUID->"504c3fa4-37da-d74e-ac6d-\
10716c8522c9"],

Cell[TextData[{
 "A map (channel) is a Semigroup if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["t", "TI"], "+", 
            StyleBox["s", "TI"], ",", "0"}]], "\[LongEqual]", 
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["t", "TI"], ",", "0"}]], "\[EmptyCircle]", 
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["s", "TI"], ",", "0"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Lambda_{t+s,0} = \\Lambda_{t,0}\\bigcirc\\Lambda_{s,0}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "12f716c9-afbb-8040-9f13-1afa063d16e3"],
 ".\nSo, if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{"\[Tau]", ",", "0"}]], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", "(", "0", ")"}], "]"}], "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", "\[Tau]", ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Lambda_{\\tau,0}[\\rho(0)] = \\rho(\\tau)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b10818c2-4f58-4f42-aaf7-2594c99b8a80"],
 ", we have:\n    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[CapitalLambda]", 
              RowBox[{
                StyleBox["t", "TI"], ",", "0"}]], "\[EmptyCircle]", 
             SubscriptBox["\[CapitalLambda]", 
              RowBox[{
                StyleBox["s", "TI"], ",", "0"}]]}], ")"}], 
         RowBox[{"[", "\[Rho]", "]"}], "\[LongEqual]", 
         SubscriptBox["\[CapitalLambda]", 
          RowBox[{
            StyleBox["t", "TI"], ",", "0"}]], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", "(", 
             StyleBox["s", "TI"], ")"}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(\\Lambda_{t,0}\\bigcirc \\Lambda_{s,0})[\\rho] \
=\\Lambda_{t,0}[\\rho(s)]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0ed8db4-18a5-1145-a61d-e34d12391bbe"],
 ", and that should be equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "(", 
         RowBox[{
           StyleBox["t", "TI"], "+", 
           StyleBox["s", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho(t+s)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ef3fb27-a1ef-db42-a458-e8672684a9d7"],
 ".\nIn this case the map is given in terms of its Kraus Operators ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "k_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5e3ded9-4b20-a845-991c-f00add034c1f"],
 "."
}], "Text",
 CellChangeTimes->{{3.9719511256509*^9, 3.9719511337929306`*^9}, {
  3.9719512467935104`*^9, 3.9719512956457767`*^9}, {3.9719513512830353`*^9, 
  3.9719513623554955`*^9}, {3.971951528755205*^9, 3.9719515527859898`*^9}, {
  3.971951583426531*^9, 3.9719515861158104`*^9}, {3.9719516220356617`*^9, 
  3.971951637281069*^9}, {3.971951672401745*^9, 3.9719516838609047`*^9}, {
  3.971951779698349*^9, 
  3.971951807522785*^9}},ExpressionUUID->"9af5ff3d-f217-1446-b66c-\
001f7ba563ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"\[CapitalGamma]", ">", "0"}], "&&", 
    RowBox[{"\[Tau]", ">", "0"}], "&&", 
    RowBox[{"s", ">", "0"}], "&&", 
    RowBox[{"t", ">", "0"}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalGamma]", ",", "\[Tau]"}], "}"}], ",", "Reals"}], 
     "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"5eeee87a-794a-4142-8305-8f717fe54743"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k1", " ", "=", " ", GridBox[{
     {"1", "0"},
     {"0", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[CapitalGamma]"}], " ", "\[Tau]"}], "]"}], "]"}]}
    },
    GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}]}], ";", 
  RowBox[{"k2", " ", "=", " ", GridBox[{
     {"0", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "\[CapitalGamma]"}], " ", "\[Tau]"}], "]"}]}], "]"}]},
     {"0", "0"}
    },
    GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"k1", "//", "MatrixForm"}], "\[IndentingNewLine]", 
 RowBox[{"k2", "//", "MatrixForm"}]}], "Input",
