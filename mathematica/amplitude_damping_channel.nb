 CellLabel->
  "Out[95]//MatrixForm=",ExpressionUUID->"f65cd52c-24f3-5543-9a4e-\
354ec74b08f5"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalLambda]", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"k1t", ",", "k2t", ",", "\[Rho]t"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"k1t", "=", 
      RowBox[{"k1", "/.", 
       RowBox[{"\[Tau]", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"k2t", "=", 
      RowBox[{"k2", "/.", 
       RowBox[{"\[Tau]", "->", "t"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]t", "=", 
      RowBox[{
       RowBox[{"k1t", ".", "x", ".", 
        RowBox[{"ConjugateTranspose", "[", "k1t", "]"}]}], " ", "+", " ", 
       RowBox[{"k2t", ".", "x", ".", 
        RowBox[{"ConjugateTranspose", "[", "k2t", "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Simplify", "[", 
      RowBox[{"\[Rho]t", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", ">", "0"}], ",", " ", 
          RowBox[{"t", ">", "0"}]}], " ", "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9719531927083626`*^9, 3.971953368545927*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"191eabfb-4468-c541-af8d-b61e50b89574"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", " ", "=", " ", GridBox[{
     {"\[Rho]00", "\[Rho]01"},
     {"\[Rho]10", "\[Rho]11"}
    },
    GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}]}], 
  ";"}]], "Input",
