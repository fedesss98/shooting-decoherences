41757d22c138"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Petz", "[", 
   RowBox[{"Ks_", ",", "t_", ",", "\[Sigma]_", ",", "\[Rho]_"}], "]"}], ":=", 
  
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"innerMatrix", ",", "Phi", ",", "PhiAdj", ",", "recovered"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Phi", "[", "rho_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", ".", "rho", ".", 
            RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "&"}], "/@",
          "Ks"}], "/.", 
        RowBox[{"\[Tau]", "->", "t"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"PhiAdj", "[", "X_", "]"}], ":=", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "#", "]"}], ".", "X", ".", 
            "#"}], ")"}], "&"}], "/@", "Ks"}], "/.", 
        RowBox[{"\[Tau]", "->", "t"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"innerMatrix", "=", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Phi", "[", "\[Sigma]", "]"}], ")"}], 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]], ".", " ", "\[Rho]", " ", ".", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Phi", "[", "\[Sigma]", "]"}], ")"}], 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]]}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{"TODO", ":", " ", 
       RowBox[{
       "Use", " ", "the", " ", "correct", " ", "Power", " ", "Operator", " ", 
        "for", " ", "matrices", " ", 
        RowBox[{"(", 
         RowBox[{
         "this", " ", "takes", " ", "the", " ", "sqrt", " ", "element", " ", 
          "by", " ", "element"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"recovered", "=", 
      RowBox[{
       SuperscriptBox["\[Sigma]", 
        RowBox[{"1", "/", "2"}]], ".", " ", 
       RowBox[{"PhiAdj", "[", "innerMatrix", "]"}], ".", " ", 
       SuperscriptBox["\[Sigma]", 
        RowBox[{"1", "/", "2"}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"recovered", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[CapitalGamma]", ">", "0"}], ",", " ", 
          RowBox[{"t", ">", "0"}]}], " ", "}"}]}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
